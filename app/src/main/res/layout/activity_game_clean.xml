<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B6623"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/playerProfileBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_margin="8dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgPlayerAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            tools:ignore="ImageContrastCheck" />

        <TextView
            android:id="@+id/tvPlayerNameInGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/player"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
    <!-- =========================================================
         DEALER CHIP


         ========================================================= -->
    <FrameLayout
        android:id="@+id/dealerChip"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:visibility="visible"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- רקע המטבע -->
        <ImageView
            android:id="@+id/dealerChipBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_dealer_chip"
            android:contentDescription="@null" />

        <!-- האות D בתוך המטבע -->
        <TextView
            android:id="@+id/dealerChipText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/d"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
    </FrameLayout>

    <!-- =========================================================
         SCOREBOARD
         לוח התוצאות.
         ========================================================= -->
    <LinearLayout
        android:id="@+id/scoreBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="20dp"
        android:padding="10dp"
        android:background="@drawable/bg_scoreboard"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvfinalTrump"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text = "@string/trump"
            android:textColor="@android:color/white"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvCaller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/caller"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvActionBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_scoreboard"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/scoreBoard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvScoreUs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_team_0"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvScoreThem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/other_team_0"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- =========================================================
         שחקן עליון - P2
         ========================================================= -->
    <LinearLayout
        android:id="@+id/p2Box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/p2Back"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:contentDescription="@string/p2_hand"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/p2Count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p2_5"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- =========================================================
         שחקן שמאלי - P1
         ========================================================= -->
    <LinearLayout
        android:id="@+id/p1Box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/trickTable"
        app:layout_constraintBottom_toBottomOf="@id/trickTable">

        <ImageView
            android:id="@+id/p1Back"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:contentDescription="@string/p1_hand"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/p1Count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p1_5"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- =========================================================
         שחקן ימני - P3
         ========================================================= -->
    <LinearLayout
        android:id="@+id/p3Box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/trickTable"
        app:layout_constraintBottom_toBottomOf="@id/trickTable">

        <ImageView
            android:id="@+id/p3Back"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:contentDescription="@string/p3_hand"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/p3Count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p3_5"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- =========================================================
         אזור מרכזי של הטריק
         ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/trickTable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/p2Box"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintStart_toEndOf="@id/p1Box"
        app:layout_constraintEnd_toStartOf="@id/p3Box">

        <ImageView
            android:id="@+id/trickP2"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:importantForAccessibility="no"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/trickP0"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:importantForAccessibility="no"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/trickP1"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:importantForAccessibility="no"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/trickP3"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:importantForAccessibility="no"
            android:src="@drawable/c_back"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- =========================================================
         שורת כפתורי פעולה
         ========================================================= -->
    <LinearLayout
        android:id="@+id/actionRow"
        style="?android:attr/buttonBarStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/handScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnTrumpH"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTrumpD"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diamond"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTrumpC"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clubs"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTrumpS"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spades"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPass"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            app:backgroundTint="#6200EE"
            android:text="@string/pass"
            android:textAllCaps="true"
            android:textColorLink="#F44336"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOrderUp"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#6200EE"
            android:text="@string/order_up"
            android:visibility="gone" />
    </LinearLayout>

    <!-- =========================================================
         היד של השחקן האנושי
         ========================================================= -->
    <HorizontalScrollView
        android:id="@+id/handScroll"
        android:contentDescription="@string/your_hand_of_cards"
        android:layout_width="0dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/handContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- =========================================================
         חבילת הקלפים במרכז
         ========================================================= -->
    <ImageView
        android:id="@+id/deckPile"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:importantForAccessibility="no"
        android:src="@drawable/c_back"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- =========================================================
         קלף ה-up card
         ========================================================= -->
    <ImageView
        android:id="@+id/upCardView"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:src="@drawable/c_back"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:elevation="12dp"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@id/deckPile"
        app:layout_constraintBottom_toBottomOf="@id/deckPile"
        app:layout_constraintStart_toStartOf="@id/deckPile"
        app:layout_constraintEnd_toEndOf="@id/deckPile"
        android:translationY="-10dp" />

    <!-- =========================================================
         הקלף המעופף לאנימציות
         ========================================================= -->
    <ImageView
        android:id="@+id/flyingCard"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:importantForAccessibility="no"
        android:src="@drawable/c_back"
        android:visibility="gone"
        android:elevation="30dp"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- =========================================================
         Overlay של סוף יד / scoring
         ========================================================= -->
    <FrameLayout
        android:id="@+id/scoringOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#88000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- הודעת "Thinking..." -->
        <LinearLayout
            android:id="@+id/thinkingOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_scoreboard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="70dp">

            <TextView
                android:id="@+id/tvThinking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thinking"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- כרטיס הסיכום של סוף היד -->
        <LinearLayout
            android:id="@+id/scoringCard"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_scoring_card">

            <TextView
                android:id="@+id/tvFinalCaller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/callerFinal"
                android:textColor="@android:color/white"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvScoringTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hand_summary"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTrump"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trumpTV"
                android:textColor="@android:color/white"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvTricks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tricks_us_0_them_0"
                android:textColor="@android:color/white"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/points_this_hand_us_0_them_0"
                android:textColor="@android:color/white"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvTotalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_us_0_them_0"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnContinueOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continueOverlay"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </FrameLayout>
    <!-- =========================================================
         GAME OVER OVERLAY
         מסך סיום משחק: ניצחון / הפסד + ניקוד סופי + כפתור משחק חדש
         ========================================================= -->
    <FrameLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#AA000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/gameOverCard"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_scoring_card">

            <TextView
                android:id="@+id/tvGameOverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_over"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvGameOverResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/you_won"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvGameOverReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/final_score_us_10_them_7"
                android:textColor="@android:color/white"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_game"
                android:layout_marginTop="18dp" />
            <Button
                android:id="@+id/btnMainMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_menu"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>